# ==============================================================================
# CWTS Web & Headless CMS Environment Configuration
# ==============================================================================
# Copy this file to .env and fill in your Firebase & Netlify configuration keys:
# cp .env.example .env

# ------------------------------------------------------------------------------
# 1. Firebase Client Configuration (Firebase Console > Project Settings > General)
# ------------------------------------------------------------------------------
PUBLIC_FIREBASE_API_KEY="AIzaSyXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXXX"
PUBLIC_FIREBASE_AUTH_DOMAIN="cwts-web.firebaseapp.com"
PUBLIC_FIREBASE_PROJECT_ID="cwts-web"
PUBLIC_FIREBASE_STORAGE_BUCKET="cwts-web.appspot.com"
PUBLIC_FIREBASE_MESSAGING_SENDER_ID="123456789012"
PUBLIC_FIREBASE_APP_ID="1:123456789012:web:abcdef1234567890abcdef"
PUBLIC_FIREBASE_MEASUREMENT_ID="G-XXXXXXXXXX"

# ------------------------------------------------------------------------------
# 2. Administrator Access Control Whitelist
# ------------------------------------------------------------------------------
# Comma-separated list of emails allowed to sign in to the /admin CMS portal.
# All accounts ending with @cwts.edu are also automatically authorized.
PUBLIC_ADMIN_EMAILS="yusheng.sjtu@gmail.com,admin@cwts.edu,webmaster@cwts.edu"

# ------------------------------------------------------------------------------
# 3. Netlify CI/CD Build Hooks (Staging Preview & Production Deployment)
# ------------------------------------------------------------------------------
# Staging Preview Hook: Triggers build for active draft preview
PUBLIC_NETLIFY_STAGING_HOOK_URL="https://api.netlify.com/build_hooks/64d8a1xxxxxxxxxxxxxxxxxx"
PUBLIC_STAGING_URL="https://cwts-staging.netlify.app"

# Production Deploy Hook: Triggers live production build upon publish
PUBLIC_NETLIFY_PROD_HOOK_URL="https://api.netlify.com/build_hooks/64d8b2xxxxxxxxxxxxxxxxxx"
PUBLIC_SITE_URL="https://cwts.edu"

# ------------------------------------------------------------------------------
# 4. Content Provider Mode (Optional - Defaults to 'astro')
# ------------------------------------------------------------------------------
# Options:
#   - 'astro': Read all data from local content collections (Default / Baseline)
#   - 'firebase': Read all data remotely from Cloud Firestore
#   - 'hybrid': Selectively route migrated collections to Firebase
CONTENT_SOURCE="astro"

# When CONTENT_SOURCE="hybrid", specify comma-separated collections to load from Firebase:
# MIGRATED_COLLECTIONS="news,jobs"
