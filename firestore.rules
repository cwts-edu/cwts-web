rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // =========================================================================
    // Authentication & Role Helpers
    // =========================================================================

    function isSignedIn() {
      return request.auth != null;
    }

    function userEmail() {
      return request.auth.token.email.lower();
    }

    // Built-in root administrator accounts (defined in src/admin/config/whitelist.ts)
    function isBootstrapAdmin() {
      return isSignedIn() &&
        userEmail() in [
          'yusheng.sjtu@gmail.com'
        ];
    }

    // Check if the current user has an active 'admin' role in Firestore /users
    function isFirestoreAdmin() {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(userEmail())) &&
        get(/databases/$(database)/documents/users/$(userEmail())).data.role == 'admin' &&
        get(/databases/$(database)/documents/users/$(userEmail())).data.status == 'active';
    }

    // Comprehensive Admin check
    function isAdmin() {
      return isBootstrapAdmin() || isFirestoreAdmin();
    }

    // Check if the user is an active authorized staff member (Admin or Editor)
    function isAuthorizedStaff() {
      return isAdmin() || (
        isSignedIn() &&
        exists(/databases/$(database)/documents/users/$(userEmail())) &&
        get(/databases/$(database)/documents/users/$(userEmail())).data.status == 'active'
      );
    }

    // =========================================================================
    // 1. User Management Collection (/users/{targetEmail})
    //    Used in src/admin/services/accountService.ts & src/admin/config/whitelist.ts
    // =========================================================================
    match /users/{targetEmail} {
      // Lookup individual document: public so registration gate can verify before account creation
      allow get: if true;
      // List all users: Administrators only
      allow list: if isAdmin();

      // Only administrators can add or delete user records
      allow create, delete: if isAdmin();

      // Admins can update any field; a logged-in user can update their registered flag and displayName
      // but cannot escalate their role or modify status
      allow update: if isAdmin() || (
        isSignedIn() &&
        userEmail() == targetEmail.lower() &&
        request.resource.data.diff(resource.data).affectedKeys().hasOnly(['registered', 'registeredAt', 'displayName'])
      );
    }

    // Legacy fallback allowlist collection (read/delete during migration)
    match /allowlist/{targetEmail} {
      allow get: if true;
      allow list, delete: if isAdmin();
      allow create, update: if false;
    }

    // =========================================================================
    // 2. CMS Content Collections
    //    Top-level collections verified from src/libs/content/index.ts (ALL_MIGRATED_COLLECTIONS):
    //    news, jobs, faculty, carousel, degrees-widget, study-mode-widget,
    //    shortcuts, degrees-programs, assembly, newsletter, pages, menu
    // =========================================================================
    match /{collection}/{docId} {
      // Content read: public (for SSG builds & site readers)
      allow read: if collection in [
        'news', 'jobs', 'faculty', 'carousel', 'degrees-widget',
        'study-mode-widget', 'shortcuts', 'degrees-programs',
        'assembly', 'newsletter', 'pages', 'menu'
      ];
      // Content write: authorized staff (Admins and Editors)
      allow write: if isAuthorizedStaff() && collection in [
        'news', 'jobs', 'faculty', 'carousel', 'degrees-widget',
        'study-mode-widget', 'shortcuts', 'degrees-programs',
        'assembly', 'newsletter', 'pages', 'menu'
      ];

      // Version history subcollection: /{collection}/{docId}/versions/{versionId}
      // Used in src/admin/views/*EditView.tsx & DraftContext.tsx
      match /versions/{versionId} {
        allow read, write: if isAuthorizedStaff();
      }
    }

    // =========================================================================
    // 3. Drafts System (/drafts/{draftId} & /drafts/{draftId}/changes/{changeId})
    //    Used in src/admin/context/DraftContext.tsx
    // =========================================================================
    match /drafts/{draftId} {
      allow read, write: if isAuthorizedStaff();

      match /changes/{changeId} {
        allow read, write: if isAuthorizedStaff();
      }
    }

    // =========================================================================
    // 4. Releases System (/releases/{releaseId})
    //    Used in src/admin/context/DraftContext.tsx
    // =========================================================================
    match /releases/{releaseId} {
      allow read, write: if isAuthorizedStaff();
    }

    // =========================================================================
    // 5. System Configuration (/config/{docId})
    //    Used in src/admin/config/whitelist.ts (/config/admins)
    // =========================================================================
    match /config/{docId} {
      allow read: if isAuthorizedStaff();
      allow write: if isAdmin();
    }

    // =========================================================================
    // 6. Schema Migrations (/_migrations/{migrationId})
    //    Used in src/admin/migrations/001_extract_referenced_assets.ts
    // =========================================================================
    match /_migrations/{migrationId} {
      allow read, write: if isAdmin();
    }
  }
}
