---
import { content, type Language } from "@libs/content";
import { groupNewslettersByYear } from "@libs/content/newsletterUtils";

const language = (Astro.params.language || "zh") as Language;
const items = await content.newsletter.list(language);
const yearGroups = groupNewslettersByYear(items);
---

{
  yearGroups.map((group) => (
    <>
      <h2>{group.year}</h2>
      <div class="not-prose flex gap-6 flex-wrap">
        {group.issues.map((item) => (
          <div>
            <a href={item.data.pdfPath} target="_blank">
              <div>{item.data.title}</div>
              <div>
                <img class="h-64" src={item.data.coverImage} alt={item.data.title} />
              </div>
            </a>
          </div>
        ))}
      </div>
    </>
  ))
}
