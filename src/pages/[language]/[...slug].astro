---
import Section from "@layouts/Section.astro";
import site from "@libs/site";
import { content, type ContentEntry, type PageMetadata } from "@libs/content";

export async function getStaticPaths() {
  const pages = await content.pages.list();
  return pages.map((page) => {
    return {
      params: {
        language: page.language,
        slug: page.slug,
      },
      props: {
        page,
      },
    };
  });
}

export interface Props {
  page: ContentEntry<PageMetadata>;
}

const { page } = Astro.props;
const { title, coverImage = site.defaultCover } = page.data;
const { Content } = await content.render(page);
---

<Section
  title={title}
  slug={page.id}
  coverImage={coverImage}
  mainImage={page.data.thumbnail}
  showChildren={page.data.showChildren}
>
  <Content />
</Section>
