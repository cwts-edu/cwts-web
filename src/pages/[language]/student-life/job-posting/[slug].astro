---
import SectionNoCover from "@layouts/SectionNoCover.astro";
import { content, type ContentEntry, type JobMetadata } from "@libs/content";

export async function getStaticPaths() {
  const jobs = await content.jobs.list();
  return jobs
    .filter((job) => job.data.file == null)
    .map((job) => ({
      params: {
        language: "zh",
        slug: job.id,
      },
      props: {
        job,
      },
    }));
}

export interface Props {
  job: ContentEntry<JobMetadata>;
}

const { job } = Astro.props;
const slug = `zh/student-life/job-posting/${job.id}`;
const { Content } = await content.render(job);
---

<SectionNoCover language={"zh"} title={job.data.title} slug={slug}>
  <div class="prose my-4">
    <Content />
  </div>
</SectionNoCover>
